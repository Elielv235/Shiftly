<Window x:Class="Shiftly.Wpf.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Shiftly - ניהול משתמשים והרשאות (מחזור 1)" 
        Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- סרגל עליון: פרטי מחובר וכפתורי פעולה -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="16" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🍔 Shiftly" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="| לוח בקרת מנהל - מחזור 1 (Users &amp; Roles)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="משתמש מחובר: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="• הרשאה: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding CurrentUser.RoleName}" Foreground="#93C5FD" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="רענן רשימה" 
                            Command="{Binding LoadUsersCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="12,6" 
                            Margin="0,0,8,0"/>
                    <Button Content="התנתק" 
                            Command="{Binding LogoutCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Background="#7F1D1D" 
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- אזור תוכן מרכזי -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- טבלת משתמשים -->
            <Border Grid.Column="0" 
                    Background="{StaticResource CardBgBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="14" 
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="רשימת עובדים ומשתמשי המערכת (מתוך SQL Server דרך ה-API)" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="{StaticResource PrimaryAccentBrush}" 
                               Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding Users}" 
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="Transparent"
                              RowBackground="#111827"
                              AlternatingRowBackground="#1F2937"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource CardBorderBrush}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#374151">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="CellTextStyle">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="מזהה" Binding="{Binding UserId}" Width="55" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="שם משתמש" Binding="{Binding Username}" Width="105" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="שם מלא" Binding="{Binding FullName}" Width="150" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="אימייל" Binding="{Binding Email}" Width="160" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn Header="תפקיד (Role)" Binding="{Binding RoleName}" Width="110" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- סרגל צד: עדכון תפקיד ובדיקות אבטחה לבוחן -->
            <StackPanel Grid.Column="1">
                
                <!-- כרטיס ניהול תפקידים (שמור לאדמין) -->
                <Border Background="{StaticResource CardBgBrush}" 
                        BorderBrush="{StaticResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16" 
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ניהול הרשאת משתמש (SEC-M13)" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{StaticResource PrimaryAccentBrush}" 
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="משתמש נבחר:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedUser.FullName, TargetNullValue='(בחר משתמש מהטבלה)'}" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,2,0,10"/>

                        <TextBlock Text="הגדר תפקיד חדש:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedNewRole}" 
                                  SelectedValuePath="Content"
                                  Height="36" 
                                  Margin="0,0,0,14">
                            <ComboBoxItem Content="Worker"/>
                            <ComboBoxItem Content="ShiftManager"/>
                            <ComboBoxItem Content="HRAdmin"/>
                        </ComboBox>

                        <Button Content="שמור שינוי תפקיד" 
                                Command="{Binding ChangeRoleCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                Height="36"/>
                    </StackPanel>
                </Border>

                <!-- כרטיס הדגמת אבטחה מיוחד לבוחן הבגרות! -->
                <Border Background="#14233C" 
                        BorderBrush="#2563EB" 
                        BorderThickness="1.5" 
                        CornerRadius="10" 
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="🎓 בדיקת בוחן: אבטחה בשרת" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="#60A5FA" 
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="הוכחה שחסימת עקיפה מבוצעת אך ורק בשרת ולא מסתמכת על ה-UI (חוק SEC-M08)." 
                                   FontSize="11" 
                                   Foreground="#93C5FD" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,10"/>

                        <Button Content="בדוק חסימת 403 Forbidden" 
                                Command="{Binding TestUnauthorizedAccessCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Background="#1E40AF"
                                Foreground="White"
                                Height="36"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- שורת סטטוס תחתונה -->
        <Border Grid.Row="2" 
                Background="{StaticResource CardBgBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{StaticResource PrimaryAccentBrush}" 
                       FontSize="12" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
