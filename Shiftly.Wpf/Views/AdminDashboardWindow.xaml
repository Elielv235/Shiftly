<Window x:Class="Shiftly.Wpf.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiftly - דשבורד מנהל סניף (Cycle 2)" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#0F172A">
    <Window.Resources>
        <!-- Explicit High-Contrast TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#0F172A" BorderBrush="#334155" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Margin="0,0,4,0" Padding="18,10">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Panel.ZIndex" Value="100"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explicit Theme-Friendly Button Style for Enabled/Disabled States -->
        <Style x:Key="AdminActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🍔 Shiftly" Foreground="#F59E0B" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | לוח בקרה מנהל (סבב 2)" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="מחובר: אליאל וולקונסקי (HRAdmin)" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="התנתק" Command="{Binding LogoutCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4 Active Functional Tabs -->
        <TabControl Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
            <!-- TAB 1: USERS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="👥 ניהול עובדים" Foreground="#F59E0B" FontSize="14" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="ניהול הרשאת משתמש" Foreground="#F59E0B" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedUserDisplayName, FallbackValue='בחר עובד מהרשימה'}" Foreground="#E2E8F0" Margin="0,0,0,15"/>
                            <TextBlock Text="הגדר תפקיד חדש:" Foreground="#94A3B8" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,15" Padding="5"/>
                            
                            <Button Content="שמור שינוי תפקיד" Command="{Binding SaveRoleCommand}" Style="{StaticResource AdminActionButtonStyle}" Background="#F59E0B" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <Button Content="השעה / הפעל עובד" Command="{Binding ToggleStatusCommand}" Style="{StaticResource AdminActionButtonStyle}" Background="#64748B" Foreground="White" Margin="0,0,0,25"/>

                            <Border Background="#1E293B" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="🎓 בדיקת בוחן: אבטחה בשרת" Foreground="#38BDF8" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="הוכחה שחסימת עקיפה מבוצעת אך ורק בשרת (SEC-M08)." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="בדוק חסימת 403 Forbidden" Command="{Binding Test403Command}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="10,6" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button Content="רענן רשימה" Command="{Binding RefreshUsersCommand}" DockPanel.Dock="Left" Background="#334155" Foreground="White" Padding="10,6" BorderThickness="0"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <TextBlock Text="חיפוש עובד: " Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="5" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#0F172A" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" Foreground="White" BorderBrush="#334155" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="מזהה" Binding="{Binding UserId}" Width="50"/>
                                <DataGridTextColumn Header="שם משתמש" Binding="{Binding Username}" Width="100"/>
                                <DataGridTextColumn Header="שם מלא" Binding="{Binding FullName}" Width="160"/>
                                <DataGridTextColumn Header="אימייל" Binding="{Binding Email}" Width="180"/>
                                <DataGridTextColumn Header="תפקיד" Binding="{Binding RoleName}" Width="110"/>
                                <DataGridCheckBoxColumn Header="פעיל" Binding="{Binding IsActive}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: BRANCH CONTROL -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="📋 בקרת סניף" Foreground="#F59E0B" FontSize="14" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="מדדי סניף חיים (Cycle 2)" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,30">
                        <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="אילוצים ממתינים" Foreground="#94A3B8" FontSize="14"/>
                                <TextBlock Text="{Binding Stats.PendingAvailabilitiesCount, FallbackValue='0'}" Foreground="#F59E0B" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="עובדים פעילים בסניף" Foreground="#94A3B8" FontSize="14"/>
                                <TextBlock Text="{Binding Stats.ActiveWorkersCount, FallbackValue='0'}" Foreground="#10B981" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="משמרות מתוקננות" Foreground="#94A3B8" FontSize="14"/>
                                <TextBlock Text="{Binding Stats.DefinedShiftsCount, FallbackValue='0'}" Foreground="#38BDF8" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="מנוע שיבוץ שבועי חכם (AI Gateway)" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="הפקת הצעת שיבוץ אוטומטית מבוססת ניתוח אילוצים ועומסי סניף מתוכננת להטמעה מלאה בסבב 4 בהתאם למחוון ה-Agile." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,15"/>
                            <Button Content="🤖 הפק הצעת שיבוץ AI לשבוע הקרוב" Command="{Binding TriggerAiDialogCommand}" Background="#334155" Foreground="#F59E0B" FontWeight="Bold" Width="300" HorizontalAlignment="Left" Padding="15,10" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: STATS -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="📊 סטטיסטיקה" Foreground="#F59E0B" FontSize="14" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="פילוח בקשות זמינות עובדים לשבוע הקרוב" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" Margin="0,0,0,25"/>
                        <TextBlock Text="בקשות לממשמרת בוקר:" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                        <ProgressBar Value="{Binding Stats.MorningRequestsCount, FallbackValue=2}" Maximum="10" Height="22" Foreground="#F59E0B" Background="#0F172A" BorderThickness="0" Margin="0,0,0,15"/>
                        <TextBlock Text="בקשות למשמרת ערב:" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                        <ProgressBar Value="{Binding Stats.EveningRequestsCount, FallbackValue=3}" Maximum="10" Height="22" Foreground="#38BDF8" Background="#0F172A" BorderThickness="0" Margin="0,0,0,25"/>
                        <TextBlock Text="* הנתונים מחושבים בזמן אמת מתוך טבלת Availabilities במסד הנתונים." Foreground="#64748B" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: COMMUNICATION -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="📢 תקשורת והודעות" Foreground="#F59E0B" FontSize="14" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="לוח הודעות והנחיות סניף פעיל" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="הודעת הנהלה: מועד סגירת אילוצים" Foreground="#38BDF8" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
                                <TextBlock Text="נא להגיש את כל אילוצי הזמינות לשבוע הבא עד יום חמישי בשעה 18:00 כדי לאפשר למנוע השיבוץ לרוץ כסדרו." Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0F172A" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="תזכורת ביקורת איכות סניפית" Foreground="#10B981" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
                                <TextBlock Text="יש להקפיד על לבוש מלא ונוהל שטיפת ידיים על פי תקן הבטיחות והמזון." Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='מערכת מוכנה - נתונים נטענו בהצלחה.'}" Foreground="#F59E0B" FontSize="12" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
