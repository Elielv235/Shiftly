<Window x:Class="Shiftly.Wpf.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Shiftly.Wpf.ViewModels"
        Title="Shiftly - הרשמת עובד חדש" 
        Height="700" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">
                
                <StackPanel>
                    
                    <TextBlock Text="הרשמת עובד חדש בסניף" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="הזן את הפרטים האישיים שלך ליצירת חשבון" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- הודעת אבטחה SEC-M11 -->
                    <Border Background="#1E3A5F" 
                            BorderBrush="{StaticResource SecondaryAccentBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10" 
                            Margin="0,0,0,16">
                        <TextBlock Text="🛡️ הערת אבטחה (SEC-M11): כל עובד נרשם אוטומטית כ-Worker. לא ניתן לקבוע הרשאות ניהול בטופס." 
                                   Foreground="#93C5FD" 
                                   FontSize="11" 
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- שם משתמש -->
                    <TextBlock Text="שם משתמש (באנגלית)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"/>
                    <TextBlock Text="{Binding UsernameError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,8"/>

                    <!-- שם מלא -->
                    <TextBlock Text="שם מלא" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"/>
                    <TextBlock Text="{Binding FullNameError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,8"/>

                    <!-- אימייל -->
                    <TextBlock Text="כתובת אימייל" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"/>
                    <TextBlock Text="{Binding EmailError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,8"/>

                    <!-- מספר טלפון -->
                    <TextBlock Text="מספר טלפון נייד" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="36"/>
                    <TextBlock Text="{Binding PhoneNumberError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,8"/>

                    <!-- סיסמה -->
                    <TextBlock Text="סיסמה (לפחות 6 תווים)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="RegPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 PasswordChanged="RegPasswordBox_PasswordChanged"
                                 Height="36"/>
                    <TextBlock Text="{Binding PasswordError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,8"/>

                    <!-- אימות סיסמה -->
                    <TextBlock Text="אימות סיסמה" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="RegConfirmPasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 PasswordChanged="RegConfirmPasswordBox_PasswordChanged"
                                 Height="36"/>
                    <TextBlock Text="{Binding ConfirmPasswordError}" Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="2,2,0,12"/>

                    <!-- הודעת סטטוס -->
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{StaticResource PrimaryAccentBrush}" 
                               FontSize="12" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- כפתור הרשמה חסום עד אימות כל השדות (Pre-Submit Block) -->
                    <Button Content="בצע הרשמה (Worker)" 
                            Style="{StaticResource ModernButtonStyle}"
                            Command="{Binding RegisterCommand}"
                            Height="40"
                            Margin="0,0,0,8"/>

                    <Button Content="ביטול וחזרה" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Height="36"/>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
