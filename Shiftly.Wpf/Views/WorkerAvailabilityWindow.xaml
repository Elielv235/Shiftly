<Window x:Class="Shiftly.Wpf.Views.WorkerAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiftly - הגשת אילוצי זמינות עובד (סבב 2)" Height="620" Width="820"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#0F172A">
    <Window.Resources>
        <!-- כפתור שליחה עם ניגודיות מלאה במצב פעיל וכבוי -->
        <Style x:Key="SubmitAvailabilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- סגנון פריט בתוך ComboBox -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- פס עליון -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="🍔 שיפטלי | הגשת זמינות שבועית לעובד" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="התנתק" Command="{Binding LogoutCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- טופס הגשת זמינות -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="25">
            <StackPanel>
                <TextBlock Text="בחר יום עבודה לשבוע הקרוב:" Foreground="#94A3B8" Margin="0,0,0,8" FontSize="14"/>

                <!-- ComboBox עם פריטים בעלי טקסט לבן מובהק -->
                <ComboBox SelectedIndex="0" 
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                          Background="#0F172A" 
                          Foreground="#FFFFFF"
                          BorderBrush="#F59E0B" 
                          BorderThickness="1.5"
                          Width="300" HorizontalAlignment="Left" Margin="0,0,0,20" Padding="8,6" FontSize="14">
                    <ComboBoxItem Content="יום ראשון (15/11/2026)"/>
                    <ComboBoxItem Content="יום שני (16/11/2026)"/>
                    <ComboBoxItem Content="יום שלישי (17/11/2026)"/>
                    <ComboBoxItem Content="יום רביעי (18/11/2026)"/>
                    <ComboBoxItem Content="יום חמישי (19/11/2026)"/>
                    <ComboBoxItem Content="יום שישי (20/11/2026)"/>
                </ComboBox>

                <TextBlock Text="משמרות מבוקשות (חובה לסמן לפחות אחת - SEC-M05):" Foreground="#94A3B8" Margin="0,0,0,10" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox Content="משמרת בוקר (07:00 - 15:30)" IsChecked="{Binding CanWorkMorning, Mode=TwoWay}" Foreground="White" FontSize="14" Margin="0,0,25,0"/>
                    <CheckBox Content="משמרת ערב (15:30 - 23:30)" IsChecked="{Binding CanWorkEvening, Mode=TwoWay}" Foreground="White" FontSize="14"/>
                </StackPanel>

                <TextBlock Text="הערות או בקשות מיוחדות למנהל המשמרת:" Foreground="#94A3B8" Margin="0,0,0,6" FontSize="14"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10" Margin="0,0,0,25" FontSize="14"/>

                <Button Content="שלח אילוצי זמינות למסד" Command="{Binding SubmitCommand}" Style="{StaticResource SubmitAvailabilityButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- הודעת משוב -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,15,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>