<Window x:Class="Shiftly.Wpf.Views.WorkerAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shiftly - אזור אישי לעובד (זמינות והחלפות משמרת)" Height="680" Width="960"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#0F172A">
    <Window.Resources>
        <!-- High-Contrast Submit Button Template -->
        <Style x:Key="SubmitAvailabilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.65"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean, High-Contrast ComboBox Style (Dark bold text ensures 100% visibility) -->
        <Style x:Key="HighContrastDayComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="HighContrastDayItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="🍔 שיפטלי | אזור אישי לעובד" Foreground="#F59E0B" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentUserHeader}" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="התנתק" Command="{Binding LogoutCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Availability Form -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="25">
            <StackPanel>
                <TextBlock Text="בחר יום עבודה לשבוע הקרוב:" Foreground="#94A3B8" Margin="0,0,0,8" FontSize="14"/>

                <!-- High-contrast, crystal-clear ComboBox for selecting target shift day -->
                <ComboBox SelectedIndex="{Binding SelectedDayIndex, Mode=TwoWay, FallbackValue=0}" 
                          Style="{StaticResource HighContrastDayComboBoxStyle}" 
                          ItemContainerStyle="{StaticResource HighContrastDayItemStyle}"
                          Width="300" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <ComboBoxItem Content="יום ראשון (15/11/2026)"/>
                    <ComboBoxItem Content="יום שני (16/11/2026)"/>
                    <ComboBoxItem Content="יום שלישי (17/11/2026)"/>
                    <ComboBoxItem Content="יום רביעי (18/11/2026)"/>
                    <ComboBoxItem Content="יום חמישי (19/11/2026)"/>
                    <ComboBoxItem Content="יום שישי (20/11/2026)"/>
                </ComboBox>

                        <TextBlock Text="משמרות מבוקשות (חובה לסמן לפחות אחת - SEC-M05):" Foreground="#94A3B8" Margin="0,0,0,10" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <CheckBox Content="משמרת בוקר (07:00 - 15:30)" IsChecked="{Binding CanWorkMorning, Mode=TwoWay}" Foreground="White" FontSize="14" Margin="0,0,25,0"/>
                            <CheckBox Content="משמרת ערב (15:30 - 23:30)" IsChecked="{Binding CanWorkEvening, Mode=TwoWay}" Foreground="White" FontSize="14"/>
                        </StackPanel>

                        <TextBlock Text="הערות או בקשות מיוחדות למנהל המשמרת:" Foreground="#94A3B8" Margin="0,0,0,6" FontSize="14"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" CaretBrush="#F59E0B" BorderBrush="#334155" Padding="10" Margin="0,0,0,22" FontSize="14"/>

                        <Button Content="שלח אילוצי זמינות למסד" Command="{Binding SubmitCommand}" Width="280" Style="{StaticResource SubmitAvailabilityButtonStyle}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 2: WORKER SCHEDULE & REQUEST SWAP (Cycle 3) -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="🔄 המשמרות שלי והחלפת משמרת" Foreground="#F59E0B" FontSize="14" FontWeight="Bold"/>
                </TabItem.Header>
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Assigned Shifts Table -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="המשמרות המשובצות שלי" Foreground="#E2E8F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="🔄 רענן משמרות" Command="{Binding RefreshScheduleCommand}"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Background="#334155" Foreground="White" FontWeight="Bold" Padding="10,6" BorderThickness="0" Cursor="Hand"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding MyAssignments}"
                                  SelectedItem="{Binding SelectedAssignment}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  Background="#0F172A"
                                  RowBackground="#1E293B"
                                  AlternatingRowBackground="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#334155"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="מזהה שיבוץ" Binding="{Binding AssignmentId}" Width="90"/>
                                <DataGridTextColumn Header="תאריך" Binding="{Binding ShiftDate, StringFormat=dd/MM/yyyy}" Width="115"/>
                                <DataGridTextColumn Header="משמרת" Binding="{Binding ShiftType}" Width="95"/>
                                <DataGridCheckBoxColumn Header="מאושר" Binding="{Binding IsConfirmed}" Width="75"/>
                                <DataGridCheckBoxColumn Header="בקשת החלפה ממתינה" Binding="{Binding HasPendingSwap}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Request Swap Panel with Real-Time Validation -->
                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="בקשת החלפת משמרת" Foreground="#F59E0B" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedAssignmentLabel}" Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="בחר עובד מחליף:" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Coworkers}"
                                      SelectedItem="{Binding SelectedCoworker}"
                                      DisplayMemberPath="FullName"
                                      Margin="0,0,0,14"/>

                            <TextBlock Text="סיבת ההחלפה (חובה, לפחות 3 תווים):" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding SwapReason, UpdateSourceTrigger=PropertyChanged}"
                                     Height="85" TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="#1E293B" Foreground="White" CaretBrush="#F59E0B"
                                     BorderBrush="#334155" Padding="10" FontSize="13" Margin="0,0,0,8"/>

                            <!-- Real-Time Validation Feedback -->
                            <TextBlock Text="{Binding SwapValidationError}" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Content="🔄 שלח בקשת החלפה"
                                    Command="{Binding SubmitSwapCommand}"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SubmitAvailabilityButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status & Confirmation Message -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,15,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>