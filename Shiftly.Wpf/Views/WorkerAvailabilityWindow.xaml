<Window x:Class="Shiftly.Wpf.Views.WorkerAvailabilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Shiftly - הגשת אילוצי זמינות עובד (סבב 2)" Height="620" Width="820"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#0F172A">
    <Window.Resources>
        <!-- High-Contrast Submit Button Template -->
        <Style x:Key="SubmitAvailabilityButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.6"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 1. Fix DatePicker Internal TextBox Text Visibility -->
        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- 2. Fix Calendar Day Buttons (1, 2, 3...) -->
        <Style x:Key="SolidCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="DayBorder" Background="Transparent" CornerRadius="4" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="DayBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Fix Calendar Month Selection Buttons (Jan, Feb...) in Year View -->
        <Style x:Key="SolidCalendarMonthButtonStyle" TargetType="{x:Type primitives:CalendarButton}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
                        <Border Background="Transparent" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Combined Calendar Style with Header Month/Year Button Fix -->
        <Style x:Key="SolidCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource SolidCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource SolidCalendarMonthButtonStyle}"/>
            <Style.Resources>
                <!-- This overrides the Header Button ("נובמבר 2026") inside CalendarItem -->
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="6,3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- 5. Complete DatePicker Style -->
        <Style x:Key="SolidDatePickerStyle" TargetType="DatePicker">
            <Setter Property="CalendarStyle" Value="{StaticResource SolidCalendarStyle}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="🍔 שיפטלי | הגשת זמינות שבועית לעובד" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="התנתק" Command="{Binding LogoutCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="10,5" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- Availability Form -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="25">
            <StackPanel>
                <TextBlock Text="בחר יום עבודה לשבוע הקרוב:" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding TargetDate, Mode=TwoWay}" 
                            Style="{StaticResource SolidDatePickerStyle}"
                            Width="260" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <TextBlock Text="משמרות מבוקשות (חובה לסמן לפחות אחת - SEC-M05):" Foreground="#94A3B8" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <CheckBox Content="משמרת בוקר (07:00 - 15:30)" IsChecked="{Binding CanWorkMorning, Mode=TwoWay}" Foreground="White" FontSize="14" Margin="0,0,25,0"/>
                    <CheckBox Content="משמרת ערב (15:30 - 23:30)" IsChecked="{Binding CanWorkEvening, Mode=TwoWay}" Foreground="White" FontSize="14"/>
                </StackPanel>

                <TextBlock Text="הערות או בקשות מיוחדות למנהל המשמרת:" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="10" Margin="0,0,0,25"/>

                <Button Content="שלח אילוצי זמינות למסד" Command="{Binding SubmitCommand}" Style="{StaticResource SubmitAvailabilityButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Status & Confirmation Message -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,15,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
